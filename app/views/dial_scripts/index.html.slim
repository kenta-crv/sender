.sc-detect.container style="padding-bottom: 100px; min-height: 100vh;"
  h2.sc-detect__title 発信原稿

  .mb-4.d-flex.gap-3
    = link_to new_dial_script_path, class: 'sc-detect__btn sc-detect__btn--warning', style: "text-decoration: none; justify-content: center; min-width: 140px;"
      | 新規原稿
    = link_to dashboard_call_batches_path, class: 'sc-detect__btn sc-detect__btn--primary', style: "text-decoration: none; justify-content: center; min-width: 140px;"
      | ダッシュボード

  .sc-detect__table-wrapper
    table.sc-detect__table
      thead
        tr
          th style="width: 60px;" ID
          th 名前
          th 想定の返事
          th 操作
      tbody
        - if @dial_scripts.any?
          - @dial_scripts.each do |script|
            tr
              td = script.id
              td
                = link_to script.name, dial_script_path(script), style: "color: #38bdf8; font-weight: 700; text-decoration: none;"
              td = script.dial_utterances.size
              td
                = link_to '編集', edit_dial_script_path(script), style: "color: #7dd3fc; margin-right: 12px;"
                = link_to '削除', dial_script_path(script), method: :delete, data: { confirm: '削除しますか？' }, style: "color: #f87171;"
        - else
          tr
            td colspan="4" 原稿はまだありません。
