.sc-detect.container.dial-script-page style="padding-bottom: 100px; min-height: 100vh;"
  h2.sc-detect__title
    | 原稿 ID #{@dial_script.id}: #{@dial_script.name}

  .mb-4.d-flex.gap-3
    = link_to '編集', edit_dial_script_path(@dial_script), class: 'sc-detect__btn sc-detect__btn--warning', style: 'text-decoration: none;'
    = link_to '一覧', dial_scripts_path, class: 'sc-detect__btn sc-detect__btn--primary', style: 'text-decoration: none;'
    = link_to dashboard_call_batches_path, class: 'sc-detect__btn sc-detect__btn--primary', style: 'text-decoration: none;'
      | ダッシュボード

  .dial-script-preview
    .sc-detect__card.mb-4
      .sc-detect__card-header
        | 電話で流す文章
      .sc-detect__card-body
        .dial-script-preview__block
          .sc-detect__label 挨拶
          p.dial-script-preview__text = @dial_script.greeting_text.presence || '（未入力）'
        .dial-script-preview__block
          .sc-detect__label 用件
          p.dial-script-preview__text = @dial_script.purpose_text.presence || '（未入力）'
        .dial-script-preview__block
          .sc-detect__label 待ち
          p.dial-script-preview__text = @dial_script.wait_text.presence || '（未入力）'
        .dial-script-preview__block
          .sc-detect__label 聞き直し
          p.dial-script-preview__text = @dial_script.text_for('repeat')
        - Call::AI_STATUS_ITEMS.each do |label|
          .dial-script-preview__block
            .sc-detect__label = label
            p.dial-script-preview__text = @dial_script.status_text(label).presence || '（未入力）'

  .sc-detect__card.mb-4
    .sc-detect__card-header
      | 想定の返事と出す原稿
    .sc-detect__card-body
      p style="margin-bottom: 16px;" 相手の言葉にこの語句が入っていたら、対応する原稿を出します。追加もここからできます。

      = form_with model: [@dial_script, @dial_utterance], local: true, html: { class: 'dial-utterance-form' } do |f|
        .row.g-3
          .col-md-6
            .sc-detect__form-group
              = f.label :phrase, '相手の言葉（含まれる語句）', class: 'sc-detect__label'
              = f.text_field :phrase, class: 'sc-detect__input', placeholder: '例: 少々お待ちください'
          .col-md-4
            .sc-detect__form-group
              = f.label :script_key, '出す原稿', class: 'sc-detect__label'
              = f.select :script_key, DialScript.utterance_options, {}, class: 'sc-detect__input'
          .col-md-2.d-flex.align-items-end
            .sc-detect__form-group.mb-0
              = f.submit '追加', class: 'sc-detect__btn sc-detect__btn--warning', style: 'justify-content: center; width: 100%;'
        - if @dial_utterance.errors.any?
          .mt-3
            - @dial_utterance.errors.full_messages.each do |msg|
              p style="color: #f87171;" = msg

      .sc-detect__table-wrapper
        table.sc-detect__table
          thead
            tr
              th 相手の言葉
              th 出す原稿
              th style="width: 80px;"
          tbody
            - if @dial_script.dial_utterances.any?
              - @dial_script.dial_utterances.order(:id).each do |utterance|
                tr
                  td = utterance.phrase
                  td = DialScript::SCRIPT_LABELS[utterance.script_key] || utterance.script_key
                  td
                    = button_to '削除', dial_script_dial_utterance_path(@dial_script, utterance), method: :delete, form: { style: 'display: inline;' }, data: { confirm: '削除しますか？' }, style: 'background: none; border: 0; color: #f87171; padding: 0; cursor: pointer;'
            - else
              tr
                td colspan="3" まだありません。上の欄から追加できます。

  .sc-detect__card.mb-4
    .sc-detect__card-header
      | FAQ（この原稿専用）
    .sc-detect__card-body
      p style="margin-bottom: 16px;" 相手の質問に近い語句があれば、登録した回答を読み上げます。

      = form_with model: [@dial_script, @dial_faq], local: true do |f|
        .sc-detect__form-group
          = f.label :question, '質問', class: 'sc-detect__label'
          = f.text_field :question, class: 'sc-detect__input', placeholder: '例: 料金はいくらですか'
        .sc-detect__form-group
          = f.label :answer, '回答（読み上げ文）', class: 'sc-detect__label'
          = f.text_area :answer, class: 'sc-detect__input', rows: 3
        .sc-detect__form-group
          = f.label :phrases, '言い回し（改行またはカンマ区切り）', class: 'sc-detect__label'
          = f.text_area :phrases, class: 'sc-detect__input', rows: 2, placeholder: '費用, いくら'
        = f.submit 'FAQを追加', class: 'sc-detect__btn sc-detect__btn--warning'
        - if @dial_faq.errors.any?
          .mt-3
            - @dial_faq.errors.full_messages.each do |msg|
              p style="color: #f87171;" = msg

      .sc-detect__table-wrapper style="margin-top: 16px;"
        table.sc-detect__table
          thead
            tr
              th 質問
              th 回答
              th 言い回し
              th style="width: 80px;"
          tbody
            - if @dial_script.dial_faqs.any?
              - @dial_script.dial_faqs.order(:id).each do |faq|
                tr
                  td = faq.question
                  td = faq.answer
                  td = faq.phrase_list.join(' / ')
                  td
                    = button_to '削除', dial_script_dial_faq_path(@dial_script, faq), method: :delete, form: { style: 'display: inline;' }, data: { confirm: '削除しますか？' }, style: 'background: none; border: 0; color: #f87171; padding: 0; cursor: pointer;'
            - else
              tr
                td colspan="4" まだありません。上の欄から追加できます。

  .sc-detect__card.mb-4
    .sc-detect__card-header
      | 未知発話ログ（直近50件）
    .sc-detect__card-body
      p style="margin-bottom: 16px;" 分類できなかった発話です。語句・FAQに足す材料に使います。

      .sc-detect__table-wrapper
        table.sc-detect__table
          thead
            tr
              th 日時
              th 発話
              th 判定経路
              th 段階
              th フォールバック
              th style="width: 80px;"
          tbody
            - if @unknown_utterances.present?
              - @unknown_utterances.each do |row|
                tr
                  td = row.created_at&.strftime('%m/%d %H:%M')
                  td = row.transcript
                  td = row.classifier_path
                  td = row.streak
                  td = DialScript::SCRIPT_LABELS[row.fallback_key] || row.fallback_key
                  td
                    = button_to '削除', dial_script_dial_unknown_utterance_path(@dial_script, row), method: :delete, form: { style: 'display: inline;' }, data: { confirm: '削除しますか？' }, style: 'background: none; border: 0; color: #f87171; padding: 0; cursor: pointer;'
            - else
              tr
                td colspan="6" まだありません。
