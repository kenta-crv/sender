.auth-oauth
  - google_ready = ENV["GOOGLE_CLIENT_ID"].present? && ENV["GOOGLE_CLIENT_SECRET"].present?
  - microsoft_ready = ENV["MICROSOFT_CLIENT_ID"].present? && ENV["MICROSOFT_CLIENT_SECRET"].present?
  - if devise_mapping.omniauthable? && (google_ready || microsoft_ready)
    .auth-oauth__stack
      - if google_ready
        = button_to client_google_oauth2_omniauth_authorize_path, \
                    method: :post, \
                    form: { data: { turbo: false }, class: "auth-oauth__form" }, \
                    class: "auth-oauth__btn auth-oauth__btn--google" do
          span.auth-oauth__icon aria-hidden="true"
            svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18" focusable="false"
              path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"
              path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"
              path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"
              path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"
          span.auth-oauth__label = t("okurite.auth.oauth_google", default: "Google")
      - if microsoft_ready
        = button_to client_microsoft_graph_omniauth_authorize_path, \
                    method: :post, \
                    form: { data: { turbo: false }, class: "auth-oauth__form" }, \
                    class: "auth-oauth__btn auth-oauth__btn--microsoft" do
          span.auth-oauth__icon aria-hidden="true"
            svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 23" width="18" height="18" focusable="false"
              path fill="#f25022" d="M1 1h10v10H1z"
              path fill="#7fba00" d="M12 1h10v10H12z"
              path fill="#00a4ef" d="M1 12h10v10H1z"
              path fill="#ffb900" d="M12 12h10v10H12z"
          span.auth-oauth__label = t("okurite.auth.oauth_microsoft", default: "Microsoft")
    .auth-oauth__divider
      span = t("okurite.auth.oauth_or", default: "または")
