#okurite-client-portal
  .wrapper
    = render 'dashboard/dashboards/sidebar'
    
    #content
      header.top-header
        .header-title-row
          h2 ダッシュボード
          .month-switcher
            = link_to dashboard_index_path(dashboard_month_params(@prev_month)),
              class: 'month-switcher__btn',
              title: '前月',
              aria: { label: '前月' } do
              | ‹
            span.month-switcher__label
              = @selected_month.strftime('%Y年%-m月')
            - if @is_current_month
              span.month-switcher__btn.is-disabled aria-disabled="true"
                | ›
            - else
              = link_to dashboard_index_path(dashboard_month_params(@next_month)),
                class: 'month-switcher__btn',
                title: '翌月',
                aria: { label: '翌月' } do
                | ›

        .user-meta
          / ===== HowToボタン =====
          = link_to dashboard_howto_path, class: 'notice-header-btn-unique' do
            i.fas.fa-question-circle
            span.notice-text 使い方

          / ===== Noticeボタン =====
          = link_to dashboard_notifications_path, class: 'notice-header-btn-unique' do
            i.fas.fa-bell
            span.notice-text 通知
            - if @unread_notification_count.to_i > 0
              span.notice-badge-unique = @unread_notification_count

          / ===== Admin・プランバッジ =====
          .notice-header-btn-unique style="cursor: default;"
            i.fas.fa-user-shield
            span.notice-text
              - if current_client.present?
                = Subscription::PLAN_NAMES[current_client.subscription_plan.to_s.to_sym] || current_client.subscription_plan.presence
              - else
                | 管理者

      / ===== 解約予約中（期間内猶予）の警告バナー =====
      - if current_client.present? && current_client.subscription_status == 'cancelled' && current_client.subscription_plan != 'none'
        .alert-neon style="margin: 1.5rem 0; padding: 1rem; background: rgba(255, 80, 80, 0.1); border: 1px solid rgba(255, 80, 80, 0.3); border-radius: 8px; color: #ff8080;"
          i.fas.fa-exclamation-triangle.me-2
          | サブスクリプションは解約手続き済みです。現在の契約期間が終了するまでダッシュボードをご利用いただけます。

      / ===== KPI =====
      .stats-grid
        .glass-card
          .card-label 月間送信数
          .card-value
            = number_with_delimiter(@total_sent.to_i)
            span.unit 件

          p.resets-in 送信実行総数

          .mini-rate
            - if current_client.present?
              - total_sent = (@total_sent || 0).to_i
              - monthly_limit = (current_client.monthly_limit || 0).to_i
              - remaining_slots = [monthly_limit - total_sent, 0].max
              = "残り枠: #{number_with_delimiter(remaining_slots)} 件 / 上限: #{number_with_delimiter(monthly_limit)} 件"
            - else
              = "上限: 無制限"

        .glass-card
          .card-label 成功
          .card-value
            = number_with_delimiter(@total_success)
            span.unit 件

          p.trend.up
            i.fas.fa-check-circle
            |  実成功（未完了含む）

          .mini-rate
            = "#{@success_rate}% 成功率"

        .glass-card
          .card-label クリック反応
          .card-value
            = number_with_delimiter(@clicked_users_count)
            span.unit 件

          p.status-text
            i.fas.fa-mouse-pointer
            |  クリック反応数

          .mini-rate
            = "#{@click_rate}% クリック率"

      / ===== SERPAPI & Form Detection Limits =====
      .stats-grid.mt-4
        .glass-card
          .card-label SERP検索
          .card-value
            = number_with_delimiter(@serp_api_used.to_i)
            span.unit 件

          p.resets-in 使用数

          .mini-rate
            - if @usage_unlimited
              = "上限: 無制限"
            - else
              - remaining_serp = [@serp_api_limit.to_i - @serp_api_used.to_i, 0].max
              = "残り: #{number_with_delimiter(remaining_serp)} 件 / 上限: #{number_with_delimiter(@serp_api_limit.to_i)} 件"

        .glass-card
          .card-label フォーム検出
          .card-value
            = number_with_delimiter(@form_detection_used.to_i)
            span.unit 件

          p.resets-in 使用数

          .mini-rate
            - if @usage_unlimited
              = "上限: 無制限"
            - else
              - remaining_form = [@form_detection_limit.to_i - @form_detection_used.to_i, 0].max
              = "残り: #{number_with_delimiter(remaining_form)} 件 / 上限: #{number_with_delimiter(@form_detection_limit.to_i)} 件"

        .glass-card
          .card-label インポート
          .card-value
            = number_with_delimiter(@import_count.to_i)
            span.unit 件

          p.resets-in インポート数

      / ===== Recent Batches =====
      .history-section.mt-5
        .glass-card
          .card-header-flex style="display: flex; justify-content: space-between; align-items: center; width: 100%;"
            h5.m-0 最近のフォーム送信

            = link_to dashboard_history_path(dashboard_month_params),
              class: 'btn-electric-outline',
              style: 'display: inline-flex; align-items: center; padding: 0.6rem 1.2rem; font-size: 0.9rem; text-decoration: none; line-height: 1; border-radius: 6px; font-weight: 500;' do

              | すべて見る
              i.fas.fa-chevron-right.ms-2 style="font-size: 0.75rem;"

          .table-responsive
            table.okurite-table style="table-layout: fixed; width: 100%;"
              thead
                tr
                  th style="width: 100px;" 日付
                  th style="width: 250px;" タイトル
                  th style="width: 90px;" 対象
                  th style="width: 90px;" 送信者
                  th style="width: 90px;" 送信者ID
                  th style="width: 120px;" 進捗
                  th style="width: 100px;" 状態

              tbody
                - if (@batches || []).blank?
                  tr
                    td colspan="7" style="text-align: center; color: #94a3b8; padding: 1.5rem;"
                      = "#{@selected_month.strftime('%Y年%-m月')}の送信履歴はありません"
                - (@batches || []).each do |batch|
                  tr
                    td = batch.created_at.strftime('%Y/%m/%d')
                    td
                      .text-ellipsis style="max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="#{batch.submission&.title || '未設定'}"
                        = batch.submission&.title || '未設定'
                    td = number_with_delimiter(batch.total_count)

                    td
                      - if batch.client.present?
                        span.text-blue クライアント
                      - elsif batch.admin.present?
                        span.text-green 管理者
                      - else
                        span.text-muted -

                    td
                      - if batch.client.present?
                        = batch.client.id
                      - elsif batch.admin.present?
                        = batch.admin.id
                      - else
                        span.text-muted -

                    td
                      - percent = batch.total_count.to_i > 0 ? ((batch.processed_count.to_f / batch.total_count) * 100).round : 0
                      .custom-progress-bg
                        .bar-electric style="width: #{percent}%;"

                    td
                      - case batch.status
                      - when 'processing'
                        span.text-blue 処理中
                      - when 'completed'
                        span.text-green 完了
                      - when 'pending'
                        span.text-muted 待機中
                      - when 'cancelled'
                        span.text-warning キャンセル
                      - else
                        span.text-muted = batch.status

      / ===== Customer Stats =====
      .history-section.mt-5
        .glass-card
          .card-header-flex
            h5.m-0 顧客状況

          .table-responsive
            table.okurite-table
              thead
                tr
                  th 指標
                  th 数値

              tbody
                tr
                  td 送信可能顧客（contact_url有）
                  td = @total_customers_count

                tr
                  td フォーム未検出
                  td = number_with_delimiter(@not_detected_count)

                tr
                  td URL未設定
                  td = number_with_delimiter(@no_url_customers_count)

      / ===== Submission Stats =====
      .history-section.mt-5
        .glass-card
          .card-header-flex
            h5.m-0 送信内容別の実績

          .table-responsive
            table.okurite-table style="table-layout: fixed; width: 100%;"
              thead
                tr
                  th style="width: 250px;" 送信内容
                  th style="width: 90px;" 送信者
                  th style="width: 90px;" 送信者ID
                  th style="width: 90px;" 合計
                  th style="width: 90px;" 成功
                  th style="width: 90px;" 失敗
                  th style="width: 90px;" 成功率
              tbody
                / Rate = 完了バッチのみ / 送信不可(フォーム未検出・CAPTCHA等)除外
                - @submission_stats.each do |stat|
                  - submission = stat[:submission]
                  - total = stat[:total_sent]
                  - success = stat[:success_count]
                  - failure = stat[:failure_count]
                  - rate = stat[:rate] || (total > 0 ? ((success.to_f / total) * 100).round(1) : 0)
                  - sender_client = stat[:sender_client]
                  - sender_admin = stat[:sender_admin]

                  tr
                    td
                      .text-ellipsis style="max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="#{submission.title}"
                        = submission.title
                    td
                      - if sender_client.present?
                        span.text-blue クライアント
                      - elsif sender_admin.present?
                        span.text-green 管理者
                      - else
                        span.text-muted -
                    td
                      - if sender_client.present?
                        = sender_client.id
                      - elsif sender_admin.present?
                        = sender_admin.id
                      - else
                        span.text-muted -
                    td = total
                    td = success
                    td = failure
                    td = "#{rate}%"

- if current_client.present? && current_client.subscription_plan == 'trial'
  .ok-trial-overlay#trialOverlay
    .ok-trial-card
      .ok-icon
        i.fas.fa-bolt

      h3 トライアル利用中

      p
        | 現在トライアルをご利用中です。
        br
        | プロプランへアップグレードして、
        br
        | 送信制限なしの体験を始めましょう。

      = link_to 'プランをアップグレードする',
        dashboard_subscription_path,
        class: 'ok-btn-primary',
        style: 'background: #38bdf8; color: #020617; font-weight: 600; text-shadow: none; box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4); animation: none; transition: all 0.2s ease;'

      button.ok-btn-close#closeTrialModal 閉じる

  javascript:
    (function() {
      const initTrialModal = () => {
        const overlay = document.getElementById('trialOverlay');
        const closeBtn = document.getElementById('closeTrialModal');

        if (overlay && closeBtn) {
          overlay.classList.remove('is-visible');
          overlay.classList.add('is-visible');

          closeBtn.onclick = (e) => {
            e.preventDefault();
            overlay.classList.remove('is-visible');
          };

          overlay.onclick = (e) => {
            if (e.target === overlay) {
              overlay.classList.remove('is-visible');
            }
          };
        }
      };

      document.addEventListener('turbo:load', initTrialModal);
    })();