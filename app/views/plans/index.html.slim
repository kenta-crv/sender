.pricing-cards-section style="background: #050505;"
  .sp-company style="background: #050505; padding: 24px 0 0;"
    .sp-company-inner style="padding: 0 40px;"
      .sp-section-header style="margin-bottom: 8px; max-width: 600px; margin-left: auto; margin-right: auto;"
        h2 style="color: #fff; font-size: 32px; font-weight: 900; margin-bottom: 6px;" プラン選択
        p.desc style="color: rgba(207,239,255,0.7); margin: 0;" あなたにぴったりのプランをお選びください

      - subscription = @subscription

      .lp-scroll-wrap style="margin-top: 35px;"
        button.lp-scroll-btn.lp-scroll-prev type="button" aria-label="前へ" onclick="scrollLpCards('.pricing-cards-grid', -1)"
          svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .pricing-cards-grid.lp-scroll-grid style="margin-top: 18px;"
          / =========================
          / TRIAL
          / =========================
          - if @is_new_account
            - is_trial_active = subscription&.trial_active?
            - trial = Subscription.new(plan_type: :trial)

            .pricing-cards-card
              h3.pricing-cards-plan-title = trial.plan_name
              p.pricing-cards-plan-sub Trial Plan
              button.pricing-cards-btn.btn-gray #{Subscription::TRIAL_DAYS}日間無料トライアル
              p style="color: rgba(207,239,255,0.7); font-size: 14px; margin-bottom: 20px;" 問い合わせフォームからのAI自動営業送信を、手軽にお試しできるプラン

              .pricing-cards-features
                .pricing-cards-feature
                  span 初期費用
                  span 0円
                hr
                .pricing-cards-feature
                  span 月額費用
                  span 0円
                hr
                .pricing-cards-feature
                  span AIリスト制作
                  span #{Subscription::PLAN_SERP_API_LIMITS[:trial]}件
                hr
                .pricing-cards-feature
                  span フォーム自動検出
                  span #{Subscription::PLAN_FORM_DETECTION_LIMITS[:trial]}件
                hr
                .pricing-cards-feature
                  span 自動フォーム営業実行
                  span #{Subscription::PLAN_DELIVERY_LIMITS[:trial]}件
                hr
                .pricing-cards-feature
                  span 契約期間
                  span #{Subscription::TRIAL_DAYS}日間
                hr

              - if is_trial_active && current_client.payment_method_registered?
                button.pricing-cards-main-btn.btn-gray disabled="disabled" style="opacity: 0.5; cursor: default;"
                  | 現在のプラン
              - elsif is_trial_active
                = link_to checkout_confirmation_path(plan_type: "trial"), class: "pricing-cards-main-btn btn-gray", style: "text-decoration: none; display: block; text-align: center;"
                  | お支払い方法を登録
              - else
                = link_to checkout_confirmation_path(plan_type: "trial"), class: "pricing-cards-main-btn btn-gray", style: "text-decoration: none; display: block; text-align: center;"
                  | このプランを選択

          / =========================
          / STANDARD
          / =========================
          - is_standard = subscription&.plan_type == 'standard' && subscription&.active?
          - standard = Subscription.new(plan_type: :standard)
          - standard_intro_price = Subscription.standard_intro_price

          .pricing-cards-card
            h3.pricing-cards-plan-title = standard.plan_name
            p.pricing-cards-plan-sub Standard Plan
            button.pricing-cards-btn.btn-blue 全体機能を満遍なく使用可能
            p style="color: rgba(207,239,255,0.7); font-size: 14px; margin-bottom: 20px;" リスト制作・フォーム検出から自動営業送信まで、全体機能を満遍なく使える標準プラン。

            .pricing-cards-features
              .pricing-cards-feature
                span 初期費用
                span 0円
              hr
              .pricing-cards-feature
                span 月額費用
                span.pricing-cards-feature-price
                  s.pricing-cards-feature-original #{standard.price.to_s(:delimited)}円
                  span.pricing-cards-feature-sale #{standard_intro_price.to_s(:delimited)}円
              hr
              .pricing-cards-feature
                span 初回特典
                span.pricing-cards-feature-price
                  span.pricing-cards-feature-sale #{Subscription::STANDARD_INTRO_MONTHS}ヶ月#{Subscription::STANDARD_INTRO_PERCENT_OFF}%OFF
              hr
              .pricing-cards-feature
                span AIリスト制作
                span #{Subscription::PLAN_SERP_API_LIMITS[:standard].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span フォーム自動検出
                span #{Subscription::PLAN_FORM_DETECTION_LIMITS[:standard].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span 自動フォーム営業実行
                span #{Subscription::PLAN_DELIVERY_LIMITS[:standard].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span 契約期間
                span いつでも解約可
              hr

            - if is_standard
              button.pricing-cards-main-btn.btn-blue disabled="disabled" style="opacity: 0.5; cursor: default;"
                | 現在のプラン
            - else
              = link_to checkout_confirmation_path(plan_type: "standard"), class: "pricing-cards-main-btn btn-blue", style: "text-decoration: none; display: block; text-align: center;"
                | このプランを選択

          / =========================
          / ENTERPRISE
          / =========================
          - is_enterprise = subscription&.plan_type == 'enterprise' && subscription&.active?
          - enterprise = Subscription.new(plan_type: :enterprise)

          .pricing-cards-card
            h3.pricing-cards-plan-title = enterprise.plan_name
            p.pricing-cards-plan-sub Enterprise Plan
            button.pricing-cards-btn.btn-green 全ての機能を最大使用可能
            p style="color: rgba(207,239,255,0.7); font-size: 14px; margin-bottom: 20px;" 大量送信を実行したい企業におすすめのプラン

            .pricing-cards-features
              .pricing-cards-feature
                span 初期費用
                span 0円
              hr
              .pricing-cards-feature
                span 月額費用
                span #{enterprise.price.to_s(:delimited)}円
              hr
              .pricing-cards-feature
                span AIリスト制作
                span #{Subscription::PLAN_SERP_API_LIMITS[:enterprise].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span フォーム自動検出
                span #{Subscription::PLAN_FORM_DETECTION_LIMITS[:enterprise].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span 自動フォーム営業実行
                span #{Subscription::PLAN_DELIVERY_LIMITS[:enterprise].to_s(:delimited)}件
              hr
              .pricing-cards-feature
                span 契約期間
                span いつでも解約可
              hr

            - if is_enterprise
              button.pricing-cards-main-btn.btn-green disabled="disabled" style="opacity: 0.5; cursor: default;"
                | 現在のプラン
            - else
              = link_to checkout_confirmation_path(plan_type: "enterprise"), class: "pricing-cards-main-btn btn-green", style: "text-decoration: none; display: block; text-align: center;"
                | このプランを選択
        button.lp-scroll-btn.lp-scroll-next type="button" aria-label="次へ" onclick="scrollLpCards('.pricing-cards-grid', 1)"
          svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
