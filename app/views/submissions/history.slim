.sc-detect.container
  h2.sc-detect__title 手動送信（営業禁止・NG対象を除く）

  .sc-detect__card
    .sc-detect__card-header
      h5 蓄積結果
    .sc-detect__card-body
      .row.text-center
        .col-md-3
          .sc-detect__label 手動送信成功
          span.fw-bold style="color: #10b981; font-size: 22px;" = "#{@manual_success_count}件"
        .col-md-3
          .sc-detect__label 手動送信失敗
          span.fw-bold style="color: #ef4444; font-size: 22px;" = "#{@manual_failure_count}件"
        .col-md-3
          .sc-detect__label 割合
          span.fw-bold style="color: #ffffff; font-size: 22px;" = "#{@manual_rate}%"
        .col-md-3
          .sc-detect__label 残り
          span.fw-bold style="color: #ffffff; font-size: 22px;" = "#{@pending_ids.size}件"
      - if @pending_ids.any?
        .sc-detect__actions
          = link_to customer_path(@pending_ids.first, all_ids: @pending_ids.join(','), submission_id: @submission.id, current_index: 0), class: 'sc-detect__btn sc-detect__btn--warning' do
            i.fas.fa-play
            | スタート

  - if notice
    .sc-detect__alert.sc-detect__alert--info.mb-4
      div
        = notice

  - if alert
    .sc-detect__alert.sc-detect__alert--info.mb-4
      div
        i.fas.fa-exclamation-triangle.me-2
        = alert

  .sc-detect__table-wrapper
    table.sc-detect__table
      thead
        tr
          th 顧客ID
          th 会社名
          th ステータス
          th 過去ステータス
          th コメント
          th 送信日時
      tbody
        - @display_rows.each_with_index do |row, index|
          - customer = row[:customer]
          - call = row[:latest_call]
          - error = row[:error_entry]
          - status_text = row[:status_text]
          - status_class = status_text == '手動送信成功' ? 'success' : (status_text == '手動送信失敗' ? 'danger' : 'warning')

          tr
            td = customer.id
            td.fw-bold = customer.company
            td
              span class="sc-detect__badge sc-detect__badge--#{status_class}"
                = status_text
            td.sc-detect__cell-wrap
              - if row[:past_statuses].present?
                = row[:past_statuses].join(' → ')
              - else
                | なし
            td.sc-detect__cell-wrap
              - if call.present?
                = call.comment
              - elsif error.present?
                = error["message"]
            td 
              - if call.present?
                = call.created_at.strftime('%y/%m/%d %H:%M')
              - else
                = row[:batch_at].strftime('%y/%m/%d %H:%M')