.sc-detect.container style="padding-bottom: 100px; min-height: 100vh;"
  h2.sc-detect__title
    | 自動発信ダッシュボード
    - if @dial_script
      span.dial-script-picker__name = @dial_script.label_for_select
  = form_with url: dashboard_call_batches_path, method: :get, local: true, class: 'mb-4 dial-script-picker' do
    = select_tag :dial_script_id, options_from_collection_for_select(@dial_scripts, :id, :label_for_select, @dial_script&.id), include_blank: (@dial_scripts.blank? ? '原稿がありません' : false), class: 'sc-detect__input'
    = submit_tag 'この原稿を表示', class: 'sc-detect__btn sc-detect__btn--primary'

  - if @dial_script
    .dial-script-preview
      .sc-detect__card.mb-4
        .sc-detect__card-header
          | 原稿 ID #{@dial_script.id}: #{@dial_script.name}
        .sc-detect__card-body
          .dial-script-preview__block
            .sc-detect__label 挨拶
            p.dial-script-preview__text = @dial_script.greeting_text.presence || '（未入力）'
          .dial-script-preview__block
            .sc-detect__label 用件
            p.dial-script-preview__text = @dial_script.purpose_text.presence || '（未入力）'
          .dial-script-preview__block
            .sc-detect__label 待ち
            p.dial-script-preview__text = @dial_script.wait_text.presence || '（未入力）'
          .dial-script-preview__block
            .sc-detect__label 聞き直し
            p.dial-script-preview__text = @dial_script.text_for('repeat')
          - Call.StatuItems.each do |label|
            .dial-script-preview__block
              .sc-detect__label = label
              p.dial-script-preview__text = @dial_script.status_text(label).presence || '（未入力）'

  / --- 本日の統計 ---
  .row.mb-4
    - stats_items = [{ label: '本日の発信数', value: @stats[:today_total], color: '#38bdf8' }] + @status_counts.select { |_label, count| count.to_i.positive? }.map { |label, count| { label: label, value: count, color: '#e2e8f0' } }
    
    - stats_items.each do |item|
      .col-md-3.mb-3
        .sc-detect__card.h-100 style="margin-bottom: 0;"
          .sc-detect__card-body.text-center
            .sc-detect__label style="margin-bottom: 10px;" = item[:label]
            h2 style="color: #{item[:color]}; font-weight: 800; text-shadow: 0 0 10px #{item[:color]}44;" = item[:value]

  / --- 現在のバッチ ---
  - if @current_batch
    .sc-detect__card.mb-4
      .sc-detect__card-header.d-flex.justify-content-between.align-items-center
        h5
          i.fas.fa-layer-group.me-2
          | 実行中バッチ: #{@current_batch.name}
        span.sc-detect__badge.sc-detect__badge--info 処理中
      .sc-detect__card-body
        .row.mb-3
          .col-md-3
            strong.me-1 style="color: #7dd3fc;" 合計:
            span = @current_batch.total_count
          .col-md-2
            strong.me-1 style="color: #7dd3fc;" 処理済:
            span = @current_batch.processed_count
          - @status_counts.each do |label, count|
            - next unless count.to_i.positive?
            .col-md-2
              strong.me-1 style="color: #e2e8f0;" = "#{label}:"
              span = count

        - batch_percent = @current_batch.total_count.to_i > 0 ? ((@current_batch.processed_count.to_f / @current_batch.total_count) * 100).round(1) : 0
        .sc-detect__progress-label = "#{batch_percent}%"
        .sc-detect__progress
          .sc-detect__progress-bar style="width: #{batch_percent}%"

        .mt-4.dial-action-row
          = link_to '詳細', call_batch_path(@current_batch), class: 'sc-detect__btn sc-detect__btn--primary'
          = button_to pause_call_batch_path(@current_batch), method: :patch, class: 'sc-detect__btn sc-detect__btn--primary', form: { class: 'dial-action-row__form' }, style: 'border-color: #f59e0b; color: #f59e0b;', data: { confirm: '発信を一時停止しますか？' } do
            | 一時停止
          = button_to cancel_call_batch_path(@current_batch), method: :patch, class: 'sc-detect__btn sc-detect__btn--danger', data: { confirm: '発信をキャンセルしますか？' } do
            | キャンセル

  / --- アクティブ通話 ---
  .sc-detect__card.mb-4
    .sc-detect__card-header.d-flex.justify-content-between.align-items-center
      h5
        i.fas.fa-phone-alt.me-2
        | アクティブ通話
      span.sc-detect__badge.sc-detect__badge--info = @active_calls.size
    .sc-detect__card-body
      - if @active_calls.any?
        .row
          - @active_calls.each do |call|
            .col-md-4.mb-3
              .sc-detect__card style="border-color: #38bdf8; box-shadow: 0 0 15px rgba(56, 189, 248, 0.2); background: rgba(15, 23, 42, 0.9);"
                .sc-detect__card-body.p-3
                  h6 style="color: #ffffff; font-weight: 700;" = call.customer&.company || '不明'
                  p.mb-2
                    small style="color: rgba(229, 231, 235, 0.5);" = call.customer&.tel
                  .d-flex.justify-content-between
                    span.sc-detect__badge.sc-detect__badge--info style="font-size: 10px;" = call.twilio_status
                    span.sc-detect__badge.sc-detect__badge--secondary style="font-size: 10px;" = call.flow_phase
      - else
        p style="color: rgba(229, 231, 235, 0.4); text-align: center; padding: 20px 0;" 現在アクティブな通話はありません。

  / --- 最近の通話 ---
  h2.sc-detect__title style="font-size: 20px;" 最近の通話
  / 見えない原因を排除するため max-height を解除し overflow を visible に
  .sc-detect__table-wrapper style="max-height: none !important; overflow: visible !important; margin-bottom: 40px;"
    table.sc-detect__table
      thead
        tr
          th 会社名
          th 電話番号
          th ステータス
          th 認識結果
          th 分類
          th 時間
          th 終了
      tbody
        - @recent_calls.each do |call|
          - row_style = ""
          tr style=row_style
            td.fw-bold = call.customer&.company
            td = call.customer&.tel
            td
              span.sc-detect__badge.sc-detect__badge--secondary = call.status.presence || '-'
            td
              pre.dial-call-log = call.speech_result.presence || '-'
            td
              span.sc-detect__badge.sc-detect__badge--info style="font-size: 10px;" = DialScript::SCRIPT_LABELS[call.speech_category] || call.speech_category
            td = call.duration ? "#{call.duration}秒" : '-'
            td = call.ended_at&.strftime('%H:%M:%S')

  .mt-5.pb-5.dial-action-row
    = link_to '新規発信', new_call_batch_path, class: 'sc-detect__btn sc-detect__btn--primary'
    = link_to 'アナリティクス', analytics_call_batches_path, class: 'sc-detect__btn sc-detect__btn--primary'
    = link_to 'バッチ一覧', call_batches_path, class: 'sc-detect__btn sc-detect__btn--primary'
    = link_to '発信原稿', dial_scripts_path, class: 'sc-detect__btn sc-detect__btn--primary'