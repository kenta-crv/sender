# Twilio認証情報
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio発信元番号
TWILIO_FROM_NUMBER=+12543263758

# 試験発信の相手役（080-2045-1020）
TEST_TO_NUMBER=+818020451020

# オペレーター転送先（03-6820-4378）
OPERATOR_NUMBER=+81368204378

# Webhook URL（開発: ngrok URL / 本番: アプリURL）
NGROK_URL=https://xxxxx.ngrok-free.dev
# APP_BASE_URL=https://your-app.com

# Google Cloud Speech-to-Text（サービスアカウントキーのパス）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# 開発時: Twilio署名検証をスキップ
SKIP_TWILIO_VALIDATION=true

# PostgreSQL（production のみ有効。development では DATABASE_URL を無視して SQLite）
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/okurite_production
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=okurite_production
# DB_USERNAME=okurite
# DB_PASSWORD=

# production で SSL 強制を無効化（ローカル検証用）
# FORCE_SSL=false

# --- OAuth (Google / Microsoft) ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Redirect URI 例: https://your-domain/clients/auth/google_oauth2/callback
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# Redirect URI 例: https://your-domain/clients/auth/microsoft_graph/callback
